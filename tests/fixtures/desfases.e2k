$ Extracto con la sintaxis real de ETABS 23.3.2 para puntos con desfase, columnas de 2 pisos y muros (geometria inventada)
$ CONTROLS
  UNITS  "TONF"  "M"  "C"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Nivel 2"  HEIGHT 3.26
  STORY "Nivel 1"  HEIGHT 3.26
  STORY "Cim"  ELEV 0

$ MATERIAL PROPERTIES
  MATERIAL  "C350"    TYPE "Concrete"    WEIGHTPERVOLUME 2.4027696
  MATERIAL  "A36"    TYPE "Steel"    WEIGHTPERVOLUME 7.8490477

$ FRAME SECTIONS
  FRAMESECTION  "C50X50"  MATERIAL "C350"  SHAPE "Concrete Rectangular"  D 0.5 B 0.5

$ SLAB PROPERTIES
  SHELLPROP  "LOSA10"  PROPTYPE  "Slab"  MATERIAL "C350"  MODELINGTYPE "Membrane"  SLABTYPE "Slab"  SLABTHICKNESS 0.1

$ WALL PROPERTIES
  SHELLPROP  "MURO20"  PROPTYPE  "Wall"  MATERIAL "C350"  MODELINGTYPE "ShellThin"  WALLTHICKNESS 0.2

$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  2.5 0
  POINT "7"  5 0 0.5
  POINT "8"  2.5 3.5 0.5
  POINT "9"  0 3.5 0.5

$ LINE CONNECTIVITIES
  LINE  "R1"  BEAM  "1"  "7"  0
  LINE  "C9"  COLUMN  "7"  "7"  2

$ AREA CONNECTIVITIES
  AREA  "W9"  PANEL  4  "1"  "2"  "2"  "1"  1  1  0  0
  AREA  "F2"  FLOOR  4  "1"  "2"  "8"  "9"  0  0  0  0

$ LINE ASSIGNS
  LINEASSIGN  "R1"  "Nivel 1"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C9"  "Nivel 2"  SECTION "C50X50"  MINNUMSTA 3

$ AREA ASSIGNS
  AREAASSIGN  "W9"  "Nivel 2"  SECTION "MURO20"  OBJMESHTYPE "DEFAULT"
  AREAASSIGN  "F2"  "Nivel 1"  SECTION "LOSA10"  OBJMESHTYPE "DEFAULT"

$ END OF MODEL FILE
